{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "modules-left": [
    "custom/nix",
    "network",
    "cpu",
    "memory",
    "ext/tags",
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "niri/language",
    "pulseaudio",
    "custom/notification"
  ],
  "niri/workspaces": {
    "format": "{icon}",
    "all-outputs": false,
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
    }
  },
  "niri/language": {
    "format": "{short}",
    "tooltip-format": "{long}",
    "on-click": "niri msg action switch-layout next",
    "on-click-right": "niri msg action switch-layout prev"
  },
  "custom/nix": {
    "format": "   ",
    "tooltip": false
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "\uf0f3<span foreground='red'><sup>●</sup></span>",
      "none": "\uf0f3",
      "dnd-notification": "\uf1f6<span foreground='red'><sup>●</sup></span>",
      "dnd-none": "\uf1f6"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  // "niri/tags": {
  //   "num-tags": 9,
  //   "tag-labels": [
  //     "1",
  //     "2",
  //     "3",
  //     "4",
  //     "5",
  //     "6",
  //     "7",
  //     "8",
  //     "9"
  //   ]
  // },
  "niri/window": {
    "format": "{app_id} | {title}",
    "icon": true,
    "icon-size": 18,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%Y年%m月%d日 %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "interval": 30
  },
  "cpu": {
    "format": "\uf2db {usage}%",
    "interval": 5
  },
  "memory": {
    "format": "\uefc5 {used:0.1f}G",
    "interval": 5
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "\uf0e7 {capacity}%",
    "format-icons": [
      "\uf244",
      "\uf243",
      "\uf242",
      "\uf241",
      "\uf240"
    ]
  },
  "network": {
    "format-wifi": "\uf1eb {signalStrength}%",
    "format-ethernet": "\udb80\udc02 {ipaddr}",
    "format-disconnected": "\udb82\udfe1 Sin red",
    "tooltip-format": "{essid} - {ifname}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\uf6a9 mute",
    "format-icons": {
      "default": [
        "\uf026",
        "\uf027",
        "\uf028"
      ]
    },
    "on-click": "pavucontrol"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
